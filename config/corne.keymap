#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E             &kp R  &kp T        &kp Y    &kp U  &kp I         &kp O    &kp P     &kp BSPC
&kp TAB     &kp A  &kp S  &kp D             &kp F  &kp G        &kp H    &kp J  &kp K         &kp L    &kp SEMI  &kp SQT
&kp LSHFT   &kp Z  &kp X  &kp C             &kp V  &kp B        &kp N    &kp M  &kp COMMA     &kp DOT  &kp FSLH  &kp LEFT_GUI
                          &kp LEFT_CONTROL  &mo 2  &kp SPACE    &kp RET  &mo 1  &kp LEFT_ALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp CAPSLOCK  &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4       &kp NUMBER_5     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp DELETE
&kp GRAVE     &kp UNDERSCORE  &kp PLUS      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH    &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &trans        &trans
&kp F1        &kp F2          &kp F3        &kp F4            &kp F5             &kp F6           &kp F7        &kp F8        &kp F9        &kp F10       &kp F11       &kp F12
                                            &trans            &kp LEFT_ALT       &trans           &trans        &trans        &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans                &kp EXCLAMATION       &kp AT_SIGN       &kp HASH        &kp DOLLAR       &kp PERCENT    &kp CARET   &kp AMPERSAND     &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DELETE
&kp TILDE             &kp MINUS             &kp EQUAL         &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE       &kp HOME    &kp PAGE_DOWN     &kp PAGE_UP   &kp END               &bt BT_SEL 0           &bt BT_SEL 1
&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp LC(UP_ARROW)  &trans          &trans           &trans         &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT    &kp C_MUTE            &kp C_VOL_DN           &kp C_VOLUME_UP
                                                              &trans          &trans           &trans         &trans      &trans            &trans
            >;
        };

        sys_layer {
            bindings = <
&sys_reset  &trans  &trans  &trans  &trans  &trans         &trans  &trans        &trans        &trans        &trans  &bt BT_CLR
&trans      &trans  &trans  &trans  &trans  &trans         &trans  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &bootloader    &trans  &trans        &trans        &trans        &trans  &trans
                            &trans  &trans  &trans         &trans  &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
